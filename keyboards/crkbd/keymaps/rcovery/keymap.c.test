/* Corne (crkbd) custom Vial keymap with OLED logo + status and RGB controls.
 *
 * Vial itself uses dynamic (runtime) keymaps, so the layers below are only the
 * power-on defaults — you can still remap everything live in the Vial app.
 * The interesting part is the OLED rendering at the bottom.
 */
#include QMK_KEYBOARD_H
#include "anim_frames.h"

enum layers { _QWERTY, _LOWER, _RAISE, _ADJUST };

const uint16_t PROGMEM keymaps[][MATRIX_ROWS][MATRIX_COLS] = {
    [_QWERTY] = LAYOUT_split_3x6_3(
        KC_TAB,  KC_Q, KC_W, KC_E, KC_R, KC_T,                        KC_Y, KC_U, KC_I,    KC_O,   KC_P,    KC_BSPC,
        KC_LCTL, KC_A, KC_S, KC_D, KC_F, KC_G,                        KC_H, KC_J, KC_K,    KC_L,   KC_SCLN, KC_QUOT,
        KC_LSFT, KC_Z, KC_X, KC_C, KC_V, KC_B,                        KC_N, KC_M, KC_COMM, KC_DOT, KC_SLSH, KC_ESC,
                              KC_LGUI, MO(_LOWER), KC_SPC,   KC_ENT, MO(_RAISE), KC_RALT
    ),
    [_LOWER] = LAYOUT_split_3x6_3(
        KC_TILD, KC_EXLM, KC_AT,   KC_HASH, KC_DLR,  KC_PERC,         KC_CIRC, KC_AMPR, KC_ASTR, KC_LPRN, KC_RPRN, KC_BSPC,
        KC_TRNS, KC_1,    KC_2,    KC_3,    KC_4,    KC_5,            KC_6,    KC_7,    KC_8,    KC_9,    KC_0,    KC_TRNS,
        KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,        KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,
                              KC_LGUI, KC_TRNS, KC_SPC,   KC_ENT, MO(_ADJUST), KC_RALT
    ),
    [_RAISE] = LAYOUT_split_3x6_3(
        KC_GRV,  KC_1,    KC_2,    KC_3,    KC_4,    KC_5,            KC_6,    KC_7,    KC_8,    KC_9,    KC_0,    KC_BSPC,
        KC_TRNS, KC_LEFT, KC_DOWN, KC_UP,   KC_RGHT, KC_TRNS,        KC_TRNS, KC_MINS, KC_EQL,  KC_LBRC, KC_RBRC, KC_BSLS,
        KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,        KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,
                              KC_LGUI, MO(_ADJUST), KC_SPC,   KC_ENT, KC_TRNS, KC_RALT
    ),
    [_ADJUST] = LAYOUT_split_3x6_3(
        QK_BOOT, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,        KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,
        RGB_TOG, RGB_MOD, RGB_HUI, RGB_SAI, RGB_VAI, KC_TRNS,        KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,
        KC_TRNS, RGB_RMOD,RGB_HUD, RGB_SAD, RGB_VAD, KC_TRNS,        KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS, KC_TRNS,
                              KC_LGUI, KC_TRNS, KC_SPC,   KC_ENT, KC_TRNS, KC_RALT
    )
};

#ifdef OLED_ENABLE
#    define ANIM_FRAME_DURATION 250  // ms per animation frame

/* Corne OLEDs are 128x32 SSD1306 mounted vertically -> rotate 270 so the
 * logical canvas is 32 wide x 128 tall. Both halves animate; the master half
 * also overlays live status text on top of its (sparse) animation. */
oled_rotation_t oled_init_user(oled_rotation_t rotation) {
    return OLED_ROTATION_270;
}

/* ----------------------------------------------------------------------------
 * ANIMATION
 *
 * Generic player: draws the current frame and advances on a timer. Each
 * physical half runs on its own MCU with its own RAM, so the caller-supplied
 * timer/index track that half's own animation independently. Frames live in
 * anim_frames.h (master_frames / slave_frames) — replace them with your own.
 * -------------------------------------------------------------------------- */
static void render_anim(const char (*frames)[512], uint8_t count,
                        uint32_t *timer, uint8_t *idx) {
    if (timer_elapsed32(*timer) > ANIM_FRAME_DURATION) {
        *timer = timer_read32();
        *idx   = (*idx + 1) % count;
    }
    oled_set_cursor(0, 0);                 // raw write starts at buffer index 0
    oled_write_raw_P(frames[*idx], 512);
}

/* ----------------------------------------------------------------------------
 * STATUS (master half): layer, modifiers, WPM — drawn on top of the animation
 * -------------------------------------------------------------------------- */
static void render_status(void) {
    oled_write_P(PSTR("Layer\n"), false);
    switch (get_highest_layer(layer_state)) {
        case _QWERTY: oled_write_P(PSTR("Base \n"), false); break;
        case _LOWER:  oled_write_P(PSTR("Lower\n"), false); break;
        case _RAISE:  oled_write_P(PSTR("Raise\n"), false); break;
        case _ADJUST: oled_write_P(PSTR("Adj  \n"), false); break;
        default:      oled_write_P(PSTR("?    \n"), false); break;
    }

    oled_write_P(PSTR("\n"), false);

    uint8_t mods = get_mods() | get_oneshot_mods();
    oled_write_P((mods & MOD_MASK_SHIFT) ? PSTR("S") : PSTR("_"), false);
    oled_write_P((mods & MOD_MASK_CTRL)  ? PSTR("C") : PSTR("_"), false);
    oled_write_P((mods & MOD_MASK_ALT)   ? PSTR("A") : PSTR("_"), false);
    oled_write_P((mods & MOD_MASK_GUI)   ? PSTR("G") : PSTR("_"), false);

    oled_write_P(PSTR("\n\nWPM\n"), false);
    oled_write(get_u8_str(get_current_wpm(), ' '), false);
}

bool oled_task_user(void) {
    static uint32_t master_timer = 0, slave_timer = 0;
    static uint8_t  master_idx   = 0, slave_idx   = 0;

    if (is_keyboard_master()) {
        // LEFT: sparse animation (blinking border) ...
        render_anim(master_frames, MASTER_FRAME_COUNT, &master_timer, &master_idx);
        // ... with layer / mods / WPM text drawn on top of it.
        oled_set_cursor(0, 0);
        render_status();
    } else {
        // RIGHT: its own full-screen animation.
        render_anim(slave_frames, SLAVE_FRAME_COUNT, &slave_timer, &slave_idx);
    }
    return false;
}
#endif  // OLED_ENABLE
